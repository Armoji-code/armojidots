*.bak
__pycache__/

# ── machine-local, never shipped ──
fish/.config/fish/fish_variables
fish/.config/fish/conf.d/local.fish
sway/.config/sway/outputs
sway/.config/sway/workspaces
sway/.config/sway/keyboard.conf
gtk/.config/gtk-3.0/bookmarks
# wallpapers are not shipped (your images live in ~/Pictures/Wallpapers)
wallpapers/

# ── generated by install.sh / theme.sh ──
fastfetch/.config/fastfetch/logo.txt
foot/.config/foot/colors.ini
foot/.config/foot/style.ini
gtk/.config/gtk-*/gtk.css
sway/.config/sway/colors.conf
sway/.config/sway/style-effects.conf
kitty/.config/kitty/style.conf
kitty/.config/kitty/theme-colors.conf

# per-user overrides written by theme.sh (cursor / fonts)
sway/.config/sway/cursor.conf
environment-d/.config/environment.d/user-cursor.conf
